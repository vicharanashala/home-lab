# HomeHub stores backend proxy — environment template.
# Copy to .env and fill in the keys you've signed up for.

# Server port (default 8787)
PORT=8787

# Allowed CORS origin. For local dev with Vite this is http://localhost:5173.
# For production set to the deployed frontend origin, e.g.
# https://j3fob22z74zqc.space.minimax.io
ALLOWED_ORIGIN=http://localhost:5173

# Requests per IP per minute (default 60)
RATE_LIMIT_PER_MINUTE=60

# ----- Provider keys -----
# Geoapify — sign up at https://myprojects.geoapify.com/ (free tier: 3,000
# credits/day). Attribution required; see TERMS.md or the README for the
# exact UI label.
GEOAPIFY_API_KEY=

# Foursquare Places — sign up at https://foursquare.com/developers/
# Free tier: 50,000 calls/month. Attribution required. Per Foursquare's
# terms, place data may NOT be stored or redistributed.
FOURSQUARE_API_KEY=

# Google Cloud Vision (optional — for photo-based stock recognition).
# Sign up at https://cloud.google.com/vision — enable the API, create an
# API key, paste it here. Free tier: 1000 LABEL_DETECTION calls/month.
# Without this key, the photo recognition falls back to an in-browser
# MobileNet model (~16 MB download, ~30 food classes covered).
GOOGLE_VISION_API_KEY=