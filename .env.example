# HomeHub frontend environment template.
# Copy to .env (Vite reads .env / .env.local automatically).

# Backend proxy base URL. Leave empty (or unset) for static-only deploys —
# the app will fall back to direct OpenStreetMap + curated data, with no
# API keys needed.
#
# When deploying the server/, set this to the server's public URL, e.g.
# VITE_API_BASE_URL=https://homehub-stores.example.com
#
# This value is BAKED INTO the frontend bundle at build time (Vite replaces
# import.meta.env.VITE_*). The server never sends API keys to the
# browser — all third-party calls happen server-side.
VITE_API_BASE_URL=

# Overwatch agent bridge URL — preferred for photo recognition.
# Same backend as the vision-overwatch server/ directory.
# Defaults to VITE_API_BASE_URL if unset, so a single backend works for both.
# Example: VITE_OVERWATCH_URL=http://localhost:8789
VITE_OVERWATCH_URL=