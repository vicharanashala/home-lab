# ── dependencies ────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── build output ────────────────────────────────────────────────────────
dist/
# Staging and retired copies used by scripts/build-app.sh, which builds the
# bundle somewhere else and swaps it in only when it is complete.
dist.staging/
dist.retired/
build/
*.tsbuildinfo

# TypeScript/Vite emit these next to the sources; they are generated.
vite.config.js
vite.config.d.ts

# ── SECRETS ─────────────────────────────────────────────────────────────
# Every .env variant is ignored EXCEPT the committed template. `bridge/shift /.env`
# holds MINIMAX_ACCESS_TOKEN and PLANTNET_API_KEY — real, paid credentials.
.env
.env.*
!.env.example

# ── local tooling / machine-specific ────────────────────────────────────
# 39 MB compiled Cloudflare binary. Install it with brew, don't ship it.
tunnel/
!tunnel/.gitkeep
plists/
.mavis/
.DS_Store
*.log
npm-debug.log*
.vscode/
.idea/

# On-device Whisper runtime (~67 MB of ONNX wasm). Copied in by
# scripts/setup-whisper-vendor.sh; the worklet that feeds it IS tracked.
public/whisper/vendor/

# ── throwaway scratch files ─────────────────────────────────────────────
# Agents work by dropping scratch files into scripts/ and then committing
# with `git add -A`, which sweeps up anything untracked. Two kinds showed up
# that must never be committed:
#   scripts/__leakprobe.txt   a synthetic secret used to try the leak scanner
#   scripts/proto-match.py    a prototype of the spoken-recipe matcher
# The first is a credential-shaped string sitting in the working tree, and the
# second is throwaway code that the TypeScript version already replaced.
# Throwaway work belongs in /tmp, which is where these now live.
scripts/__*.txt
scripts/proto-*.py
